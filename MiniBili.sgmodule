#!name=Bilibili Web to MiniBili
#!desc=将 m.bilibili.com 的视频链接重定向至 MiniBili 客户端。必须解密 m.bilibili.com 才能匹配路径和执行重定向
#!category=MiniBili

[URL Rewrite]
^https?:\/\/m\.bilibili\.com\/video\/(BV\w+) minibili://video/$1 302
^https?:\/\/search\.bilibili\.com\/([a-zA-Z0-9_]+)\?.*keyword=([^&]+).* minibili://search?keyword=$2&type=$1 302

[MITM]
hostname = %APPEND% m.bilibili.com, search.bilibili.com
