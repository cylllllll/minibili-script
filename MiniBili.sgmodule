#!name=Bilibili Web to MiniBili
#!desc=将 bilibili 的视频链接重定向至 MiniBili 客户端。必须开启MITM才能匹配路径和执行重定向
#!category=MiniBili

[URL Rewrite]
^https?:\/\/m\.bilibili\.com\/video\/([a-zA-Z0-9]+) minibili://video/$1 302
^https?:\/\/search\.bilibili\.com\/([a-zA-Z0-9_]+)\?.*keyword=([^&]+).* minibili://search?keyword=$2&type=$1 302

[MITM]
hostname = %APPEND% m.bilibili.com, search.bilibili.com, www.bilibili.com
