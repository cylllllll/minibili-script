#!name=MiniBili 跳转
#!desc=将 Bilibili 网页视频和搜索链接重定向到 MiniBili App
#!author=Minibili
#!icon=https://raw.githubusercontent.com/bilibili/favicon.ico

[Rewrite]
# 1. BV号
^https?:\/\/(www\.|m\.)?bilibili\.com\/video\/(BV[A-Za-z0-9]+).* minibili://video/$2 302

# 2. av号 (显式 av)
^https?:\/\/(www\.|m\.)?bilibili\.com\/video\/av([0-9]+).* minibili://video/av$2 302

# 3. 纯数字 aid
^https?:\/\/(www\.|m\.)?bilibili\.com\/video\/([0-9]+)\/?(\?.*)?$ minibili://video/$2 302

# 4. 搜索重定向 (注意 $2 是关键词，$1 是类型)
^https?:\/\/search\.bilibili\.com\/([a-zA-Z0-9_]+)\?.*keyword=([^&]+).* minibili://search?keyword=$2&type=$1 302

[MITM]
hostname = www.bilibili.com, m.bilibili.com, bilibili.com, search.bilibili.com
